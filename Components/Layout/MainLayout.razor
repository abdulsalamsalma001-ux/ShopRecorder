@inherits LayoutComponentBase

<div class="layout">

    @* ===== Sidebar (desktop) ===== *@
    <aside class="sidebar d-none d-lg-flex">
        <div class="brand">
            <span class="brand-mark"><i class="bi bi-bag"></i></span>
            <span class="brand-name">Shop<em>Recorder</em></span>
        </div>

        <nav class="side-nav">
            <NavLink class="nav-item" href="/" Match="NavLinkMatch.All">
                <i class="bi bi-grid-1x2"></i><span>Dashboard</span>
            </NavLink>
            <NavLink class="nav-item" href="/products">
                <i class="bi bi-box-seam"></i><span>Products</span>
            </NavLink>
            <NavLink class="nav-item" href="/pos">
                <i class="bi bi-cart2"></i><span>Sell&nbsp;<span class="nav-hint">POS</span></span>
            </NavLink>
            <NavLink class="nav-item" href="/sales">
                <i class="bi bi-receipt"></i><span>Sales History</span>
            </NavLink>
        </nav>

        <div class="sidebar-foot">
            <i class="bi bi-geo-alt"></i> Accra &middot; GHS
        </div>
    </aside>

    <div class="main-col">

        @* ===== Topbar (mobile) ===== *@
        <header class="topbar d-lg-none">
            <div class="brand brand-sm">
                <span class="brand-mark"><i class="bi bi-bag"></i></span>
                <span class="brand-name">Shop<em>Recorder</em></span>
            </div>
        </header>
        <nav class="mobilenav d-lg-none">
            <NavLink class="nav-item" href="/" Match="NavLinkMatch.All"><i class="bi bi-grid-1x2"></i><span>Dashboard</span></NavLink>
            <NavLink class="nav-item" href="/products"><i class="bi bi-box-seam"></i><span>Products</span></NavLink>
            <NavLink class="nav-item" href="/pos"><i class="bi bi-cart2"></i><span>Sell</span></NavLink>
            <NavLink class="nav-item" href="/sales"><i class="bi bi-receipt"></i><span>Sales</span></NavLink>
        </nav>

        <main class="content">
            @Body
        </main>

    </div>
</div>

@* Toast notifications are rendered by js/app.js into this host *@
<div id="toastHost" class="toast-container position-fixed bottom-0 end-0 p-3"></div>

@page "/pos"
@inject ISQLiteService Db
@inject IJSRuntime JS
@inject NavigationManager Nav

<PageTitle>Sell — ShopRecorder</PageTitle>

<div class="page page-pos">
    <div class="page-head">
        <div>
            <h1>Sell</h1>
            <p class="page-sub">Tap a product to add it to the cart</p>
        </div>
    </div>

    @if (!Loaded)
    {
        <div class="loading"><span class="spinner-border spinner-border-sm"></span> Loading products…</div>
    }
    else
    {
        <div class="pos-grid">

            @* ================= LEFT: product list ================= *@
            <div class="pos-left">
                <div class="search-box mb-3">
                    <i class="bi bi-search"></i>
                    <input type="text" placeholder="Search products…" @bind-value="Search" @bind-value:event="oninput" />
                </div>

                @if (Filtered.Count == 0)
                {
                    <div class="empty-state">
                        <i class="bi bi-search"></i>
                        <p>No products match your search.</p>
                    </div>
                }
                else
                {
                    <div class="prod-grid">
                        @foreach (var p in Filtered)
                        {
                            <button class="prod-tile" @onclick="() => AddToCart(p)" disabled="@(p.StockQuantity == 0)">
                                <span class="chip lg @ChipClass(p)">@Initial(p)</span>
                                <span class="tile-name">@p.Name</span>
                                <span class="tile-price">@Fmt.Money(p.Price)</span>
                                <span class="tile-stock @(StockClass(p))">
                                    @if (p.StockQuantity == 0)
                                    {
                                        <text>Out of stock</text>
                                    }
                                    else
                                    {
                                        <text>@p.StockQuantity in stock</text>
                                    }
                                </span>
                            </button>
                        }
                    </div>
                }
            </div>

            @* ================= RIGHT: cart ================= *@
            <aside class="pos-right">
                <div class="cart-panel">
                    <div class="cart-head">
                        <span><i class="bi bi-cart2"></i> Current sale</span>
                        @if (Cart.Count > 0)
                        {
                            <span class="cart-count">@Cart.Sum(c => c.Quantity) items</span>
                        }
                    </div>

                    @if (Cart.Count == 0)
                    {
                        <div class="cart-empty">
                            <i class="bi bi-basket2"></i>
                            <p>Cart is empty</p>
                            <span>Add products from the left</span>
                        </div>
                    }
                    else
                    {
                        <div class="cart-lines">
                            @foreach (var line in Cart.ToList())
                            {
                                <div class="cart-line">
                                    <div class="cl-info">
                                        <div class="cl-name">@line.ProductName</div>
                                        <div class="cl-unit">@Fmt.Money(line.Price) each</div>
                                    </div>
                                    <div class="cl-qty">
                                        <button class="qty-btn" title="Decrease" @onclick="() => Dec(line)"><i class="bi bi-dash"></i></button>
                                        <span class="qty-num">@line.Quantity</span>
                                        <button class="qty-btn" title="Increase" disabled="@AtMax(line)" @onclick="() => Inc(line)"><i class="bi bi-plus"></i></button>
                                    </div>
                                    <div class="cl-sub">@Fmt.Money(line.Subtotal)</div>
                                    <button class="cl-remove" title="Remove" @onclick="() => Remove(line)"><i class="bi bi-x-lg"></i></button>
                                </div>
                            }
                        </div>

                        <div class="cart-summary">
                            <div class="cs-row total">
                                <span>Total</span>
                                <span>@Fmt.Money(Total)</span>
                            </div>

                            <label class="pay-label" for="payInput">Customer payment (GHS)</label>
                            <input id="payInput" type="number" step="0.01" min="0" class="form-control pay-input" @bind="Payment" placeholder="0.00" />

                            <div class="cash-chips">
                                <button class="chip-btn" @onclick="() => AddCash(10)">+10</button>
                                <button class="chip-btn" @onclick="() => AddCash(20)">+20</button>
                                <button class="chip-btn" @onclick="() => AddCash(50)">+50</button>
                                <button class="chip-btn" @onclick="() => AddCash(100)">+100</button>
                                <button class="chip-btn accent" @onclick="SetExact">Exact</button>
                            </div>

                            @if (Total > 0 && Payment > Total)
                            {
                                <div class="change-line ok"><i class="bi bi-coin"></i> Change: <b>@Fmt.Money(Payment - Total)</b></div>
                            }
                            else if (Payment > 0 && Payment < Total)
                            {
                                <div class="change-line bad"><i class="bi bi-exclamation-triangle"></i> Short by @Fmt.Money(Total - Payment)</div>
                            }

                            <button class="btn btn-complete w-100" @onclick="CompleteSale" disabled="@(!CanComplete)">
                                <i class="bi bi-check2-circle"></i> Complete sale — @Fmt.Money(Total)
                            </button>
                            <button class="btn btn-link clear-cart" @onclick="ClearCart">Clear cart</button>
                        </div>
                    }
                </div>
            </aside>

        </div>
    }
</div>

@code {
    private List<Product> Products = new();
    private List<CartLine> Cart = new();
    private bool Loaded;
    private string Search = "";
    private decimal Payment;

    private class CartLine
    {
        public int ProductId { get; set; }
        public string ProductName { get; set; } = "";
        public decimal Price { get; set; }
        public int Quantity { get; set; }
        public int MaxStock { get; set; }
        public decimal Subtotal => Price * Quantity;
    }

    private List<Product> Filtered =>
        string.IsNullOrWhiteSpace(Search)
            ? Products
            : Products.Where(p => p.Name.Contains(Search.Trim(), StringComparison.OrdinalIgnoreCase)).ToList();

    private decimal Total => Cart.Sum(c => c.Subtotal);
    private bool CanComplete => Cart.Count > 0 && Total > 0 && Payment >= Total;

    protected override async Task OnInitializedAsync()
    {
        await Db.Init();
        Products = await Db.GetProducts();
        Loaded = true;
    }

    private async Task LoadProducts() => Products = await Db.GetProducts();

    // ---------- Cart actions ----------

    private void AddToCart(Product p)
    {
        if (p.StockQuantity <= 0) return;
        var line = Cart.FirstOrDefault(c => c.ProductId == p.Id);
        if (line is null)
        {
            Cart.Add(new CartLine { ProductId = p.Id, ProductName = p.Name, Price = p.Price, Quantity = 1, MaxStock = p.StockQuantity });
        }
        else if (line.Quantity < p.StockQuantity)
        {
            line.Quantity++;
        }
        else
        {
            Toast($"Only {p.StockQuantity} × \"{p.Name}\" in stock.", "error");
        }
    }

    private void Inc(CartLine line)
    {
        if (line.Quantity < line.MaxStock) line.Quantity++;
        else Toast($"Only {line.MaxStock} × \"{line.ProductName}\" in stock.", "error");
    }

    private void Dec(CartLine line)
    {
        line.Quantity--;
        if (line.Quantity <= 0) Cart.Remove(line);
    }

    private void Remove(CartLine line) => Cart.Remove(line);
    private void ClearCart() { Cart.Clear(); Payment = 0; }

    private bool AtMax(CartLine line) => line.Quantity >= line.MaxStock;

    private void AddCash(decimal amount) => Payment += amount;
    private void SetExact() => Payment = Total;

    // ---------- Checkout ----------

    private async Task CompleteSale()
    {
        if (!CanComplete)
        {
            await Toast("Add items and enter a payment of at least the total.", "error");
            return;
        }

        var items = Cart.Select(c => new SaleItem
        {
            ProductId = c.ProductId,
            ProductName = c.ProductName,
            Quantity = c.Quantity,
            Price = c.Price,
        }).ToList();

        try
        {
            var saleId = await Db.RecordSale(items, Payment);

            Cart.Clear();
            Payment = 0;
            await LoadProducts();

            await Toast($"Sale {Fmt.ReceiptNo(saleId)} recorded.", "success");
            Nav.NavigateTo($"/receipt/{saleId}");
        }
        catch (InsufficientStockException ex)
        {
            await Toast(ex.Message, "error");
            await LoadProducts();
        }
        catch (Exception ex)
        {
            await Toast($"Could not complete the sale: {ex.Message}", "error");
        }
    }

    private Task Toast(string message, string type) => JS.InvokeVoidAsync("ui.toast", message, type).AsTask();

    // ---- tiny view helpers ----
    private string Initial(Product p) => string.IsNullOrEmpty(p.Name) ? "?" : p.Name[..1].ToUpperInvariant();

    private string ChipClass(Product p) => "chip-" + (p.Id % 5) switch { 0 => "a", 1 => "b", 2 => "c", 3 => "d", _ => "e" };

    private string StockClass(Product p) =>
        p.StockQuantity == 0 ? "none" : (p.StockQuantity <= p.LowStockThreshold ? "low" : "ok");
}
